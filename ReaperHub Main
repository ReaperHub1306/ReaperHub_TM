local ConfigFile = "ReaperHub_Config.json"
_G.ReaperHubConfig = _G.ReaperHubConfig or { 
    AutoSave = false, 
    Language = "English",
    Toggles = {} 
}

local function SaveConfig()
    pcall(function()
        if writefile then 
            writefile(ConfigFile, HttpService:JSONEncode(_G.ReaperHubConfig)) 
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFile) then
            local data = HttpService:JSONDecode(readfile(ConfigFile))
            if type(data) == "table" then
                _G.ReaperHubConfig.AutoSave = data.AutoSave or false
                _G.ReaperHubConfig.Language = data.Language or "English"
                _G.ReaperHubConfig.Toggles = data.Toggles or {}
            end
        end
    end)
end
LoadConfig()

