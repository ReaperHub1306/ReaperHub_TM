local TranslatableLabels = {}

local function RegisterTranslation(obj, key)
    table.insert(TranslatableLabels, {obj = obj, key = key})
    local currentLang = _G.ReaperHubConfig.Language or "English"
    if Translations[currentLang] and Translations[currentLang][key] then
        obj.Text = Translations[currentLang][key]
    end
end

local function ApplyLanguage(lang)
    _G.ReaperHubConfig.Language = lang
    if _G.ReaperHubConfig.AutoSave then SaveConfig() end
    
    for _, item in ipairs(TranslatableLabels) do
        if item.obj and item.obj.Parent then
            local translated = Translations[lang] and Translations[lang][item.key]
            if translated then
                item.obj.Text = translated
            end
        end
    end
end

