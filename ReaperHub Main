local ConfigFile = "ReaperHub_Config.json"
_G.ReaperHubConfig = _G.ReaperHubConfig or {
    AutoSave = false,
    Language = "English",
    Toggles = {}
}

local function SaveConfig()
    pcall(function()
        if writefile then
            writefile(ConfigFile, HttpService:JSONEncode(_G.ReaperHubConfig))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFile) then
            local data = HttpService:JSONDecode(readfile(ConfigFile))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    _G.ReaperHubConfig[k] = v
                end
            end
        end
    end)
end

LoadConfig()

-- Bảng quản lý cập nhật chữ theo ngôn ngữ
local TranslatableLabels = {}

local function RegisterTranslation(textLabel, originalTextKey)
    table.insert(TranslatableLabels, {label = textLabel, key = originalTextKey})
    local currentLang = _G.ReaperHubConfig.Language or "English"
    if Translations[currentLang] and Translations[currentLang][originalTextKey] then
        textLabel.Text = Translations[currentLang][originalTextKey]
    end
end

local function ApplyLanguage(lang)
    _G.ReaperHubConfig.Language = lang
    if _G.ReaperHubConfig.AutoSave then SaveConfig() end
    
    for _, item in ipairs(TranslatableLabels) do
        if item.label and item.label.Parent then
            if Translations[lang] and Translations[lang][item.key] then
                item.label.Text = Translations[lang][item.key]
            end
        end
    end
end

