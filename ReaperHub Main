local function AddBtn(parentContainer, btnNameKey, rawUrl)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 0, 36)
    Container.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    Container.LayoutOrder = GetNextOrder()
    Container.Parent = parentContainer
    Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 4)
    
    local Strk = Instance.new("UIStroke", Container)
    Strk.Color = Color3.fromRGB(60, 60, 60)

    local TextLbl = Instance.new("TextLabel")
    TextLbl.Size = UDim2.new(1, -60, 1, 0)
    TextLbl.Position = UDim2.new(0, 10, 0, 0)
    TextLbl.BackgroundTransparency = 1
    TextLbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    TextLbl.Font = Enum.Font.GothamMedium
    TextLbl.TextSize = 13
    TextLbl.TextXAlignment = Enum.TextXAlignment.Left
    TextLbl.Parent = Container

    RegisterTranslation(TextLbl, btnNameKey)

    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 44, 0, 22)
    SwitchBtn.Position = UDim2.new(1, -54, 0.5, -11)
    SwitchBtn.Text = ""
    SwitchBtn.Parent = Container
    Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 18, 0, 18)
    Knob.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
    Knob.Parent = SwitchBtn
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local isOn = (btnNameKey == "Save config") and _G.ReaperHubConfig.AutoSave or (_G.ReaperHubConfig.Toggles[btnNameKey] or false)

    local function updateVisual(state)
        -- Công tắc ON = Màu trắng xám sáng (220), OFF = Màu tối (50)
        SwitchBtn.BackgroundColor3 = state and Color3.fromRGB(200, 200, 200) or Color3.fromRGB(50, 50, 50)
        Knob.BackgroundColor3 = state and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(220, 220, 220)
        Knob.Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    end

    updateVisual(isOn)
    if isOn and btnNameKey ~= "Save config" then RunRaw(rawUrl) end

    SwitchBtn.Activated:Connect(function()
        isOn = not isOn
        updateVisual(isOn)

        if btnNameKey == "Save config" then
            _G.ReaperHubConfig.AutoSave = isOn
            SaveConfig()
        else
            _G.ReaperHubConfig.Toggles[btnNameKey] = isOn
            if _G.ReaperHubConfig.AutoSave then SaveConfig() end
            RunRaw(rawUrl)
        end
    end)
end

