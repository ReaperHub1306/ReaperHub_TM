local ConfigFile = "ReaperHub_Config.json"
_G.ReaperHubConfig = _G.ReaperHubConfig or { 
    AutoSave = false, 
    Language = "English",
    Toggles = {} 
}

local function SaveConfig()
    pcall(function()
        if writefile then writefile(ConfigFile, HttpService:JSONEncode(_G.ReaperHubConfig)) end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFile) then
            local data = HttpService:JSONDecode(readfile(ConfigFile))
            if type(data) == "table" then
                _G.ReaperHubConfig = data
                _G.ReaperHubConfig.Toggles = _G.ReaperHubConfig.Toggles or {}
                _G.ReaperHubConfig.Language = _G.ReaperHubConfig.Language or "English"
            end
        end
    end)
end
