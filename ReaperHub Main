local tabs = {}
local function CreateTab(name, isFirst)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0, 85, 1, 0)
    TabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(45, 45, 45) or Color3.fromRGB(25, 25, 25)
    TabBtn.Text = name
    TabBtn.TextColor3 = isFirst and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 160)
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.TextSize = 13
    TabBtn.Parent = TabScroll
    
    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 4)
    TabCorner.Parent = TabBtn
    
    local TabStroke = Instance.new("UIStroke")
    TabStroke.Color = isFirst and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
    TabStroke.Thickness = isFirst and 1.5 or 1
    TabStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    TabStroke.Parent = TabBtn
    
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.Position = UDim2.new(0, 0, 0, 0)
    Page.BackgroundTransparency = 1
    Page.CanvasSize = UDim2.new(0, 0, 0, 360)
    Page.ScrollBarThickness = 6
    Page.ScrollBarImageColor3 = Color3.fromRGB(220, 220, 220)
    Page.ScrollingDirection = Enum.ScrollingDirection.Y
    Page.Visible = isFirst
    Page.Parent = PagesContainer
    
    table.insert(tabs, {btn = TabBtn, page = Page, stroke = TabStroke})
    return Page
end

-- TẠO CÁC TAB
local MainPage = CreateTab("Main", true)
local VisualPage = CreateTab("visual", false)
local CilentPage = CreateTab("Cilent", false)
local PvPPage = CreateTab("pvp", false)
local TradingPage = CreateTab("trading", false)
local SettingPage = CreateTab("setting", false)

for _, t in ipairs(tabs) do
    t.btn.Activated:Connect(function()
        for _, otherT in ipairs(tabs) do
            otherT.page.Visible = false
            otherT.btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            otherT.stroke.Color = Color3.fromRGB(60, 60, 60)
            otherT.stroke.Thickness = 1
            otherT.btn.TextColor3 = Color3.fromRGB(160, 160, 160)
        end
        t.page.Visible = true
        t.btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        t.stroke.Color = Color3.fromRGB(255, 255, 255)
        t.stroke.Thickness = 1.5
        t.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
end

