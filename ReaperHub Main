    local OptionHolder = Instance.new("Frame")
    OptionHolder.Size = UDim2.new(1, 0, 0, 70)
    OptionHolder.Position = UDim2.new(0, 0, 0, 36)
    OptionHolder.BackgroundTransparency = 1
    OptionHolder.Parent = DropdownContainer

    local OptionList = Instance.new("UIListLayout", OptionHolder)
    OptionList.SortOrder = Enum.SortOrder.LayoutOrder
    OptionList.Padding = UDim.new(0, 4)

    local isOpen = false
    for _, lang in ipairs({"English", "Tiếng Việt"}) do
        local OptionBtn = Instance.new("TextButton")
        OptionBtn.Size = UDim2.new(1, -12, 0, 30)
        OptionBtn.Position = UDim2.new(0, 6, 0, 0)
        OptionBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        OptionBtn.Text = lang
        OptionBtn.TextColor3 = (_G.ReaperHubConfig.Language == lang) and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(200, 200, 200)
        OptionBtn.Font = Enum.Font.GothamMedium
        OptionBtn.TextSize = 13
        OptionBtn.Parent = OptionHolder
        Instance.new("UICorner", OptionBtn).CornerRadius = UDim.new(0, 4)

        OptionBtn.Activated:Connect(function()
            isOpen = false
            ArrowLbl.Text = ">"
            DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 36), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
            
            -- Cập nhật ngôn ngữ và lưu file
            _G.ReaperHubConfig.Language = lang
            TitleLbl.Text = "Language: " .. lang
            if _G.ReaperHubConfig.AutoSave then SaveConfig() end
            
            RunRaw("https://raw.githubusercontent.com/ReaperHub1306/ReaperHub_TM/refs/heads/main/LanguageModule.lua")
        end)
    end

    DropHeader.Activated:Connect(function()
        isOpen = not isOpen
        ArrowLbl.Text = isOpen and "v" or ">"
        DropdownContainer:TweenSize(UDim2.new(1, 0, 0, isOpen and 108 or 36), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    end)
end

