-- HÀM CHẠY SCRIPT TỪ GITHUB
local function RunRaw(rawUrl)
    if not rawUrl or rawUrl == "" then return end
    task.spawn(function()
        if not ScriptCache[rawUrl] then
            local success, code = pcall(function() return game:HttpGet(rawUrl .. "?v=" .. tick()) end)
            if success and code then ScriptCache[rawUrl] = code end
        end
        if ScriptCache[rawUrl] then loadstring(ScriptCache[rawUrl])() end
    end)
end

